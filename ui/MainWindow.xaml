<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RevitServer Synx" Width="1500" Height="860" MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F1F5F9" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#0369A1"/><SolidColorBrush x:Key="AccentDark" Color="#075985"/>
    <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentDark}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers></Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="#B91C1C"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="AlternatingRowBackground" Value="#F8FAFC"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#082F49" Padding="24,18"><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="REVIT SERVER ACCELERATOR" Foreground="#BAE6FD" FontSize="12" FontWeight="Bold"/><TextBlock Text="Synx — диагностика и ремонт кэша" Foreground="White" FontSize="25" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right"><TextBlock Text="Режим" Foreground="#BAE6FD" HorizontalAlignment="Right"/><TextBlock x:Name="AdminStatusText" Text="Проверка..." Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/></StackPanel></DockPanel></Border>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="20,18,20,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="280"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Версия Accelerator:" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="InstanceCombo" Grid.Column="1" DisplayMemberPath="Name" MinHeight="34" VerticalContentAlignment="Center"/><Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Прочитать логи и базы" Margin="12,0,10,0"/><TextBlock x:Name="SummaryText" Grid.Column="3" Text="Экземпляры ещё не проверены" Foreground="#475569" VerticalAlignment="Center" TextWrapping="Wrap"/><StackPanel Grid.Column="4" Orientation="Horizontal"><Button x:Name="LoadNamesButton" Style="{StaticResource PrimaryButton}" Content="База имён..."/><Button x:Name="OpenLogButton" Style="{StaticResource PrimaryButton}" Content="Открыть AutoSyncLog" Margin="0"/></StackPanel></Grid></Border>
    <Grid Grid.Row="2" Margin="20,0,20,12"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Модели в кэше Accelerator" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid x:Name="ModelsGrid"><DataGrid.Columns><DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="105"/><DataGridTextColumn Header="Имя модели" Binding="{Binding Name}" Width="220"/><DataGridTextColumn Header="GUID модели" Binding="{Binding Guid}" Width="285"/><DataGridTextColumn Header="Host" Binding="{Binding HostNode}" Width="170"/><DataGridTextColumn Header="Зависаний" Binding="{Binding HangCount}" Width="85"/><DataGridTextColumn Header="Ошибок" Binding="{Binding ErrorCount}" Width="70"/><DataGridCheckBoxColumn Header="Кэш" Binding="{Binding CacheExists}" Width="55"/></DataGrid.Columns></DataGrid></DockPanel></Border>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Ошибки AutoSync" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid x:Name="ErrorsGrid"><DataGrid.Columns><DataGridTextColumn Header="Время" Binding="{Binding Time, StringFormat=dd.MM HH:mm:ss}" Width="115"/><DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="120"/><DataGridTextColumn Header="GUID" Binding="{Binding Guid}" Width="150"/><DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
        <Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Выбранная модель" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="SelectedText" Text="Выберите строку слева" TextWrapping="Wrap" Foreground="#475569" Margin="0,8,0,10"/><StackPanel Orientation="Horizontal"><Button x:Name="RepairButton" Style="{StaticResource DangerButton}" Content="Исправить выбранную модель" IsEnabled="False"/><Button x:Name="OpenCacheButton" Style="{StaticResource PrimaryButton}" Content="Открыть каталог" IsEnabled="False"/></StackPanel><TextBlock x:Name="RepairStepText" Text="Ремонт не запущен" Foreground="#334155" FontWeight="SemiBold" Margin="0,12,0,5"/><ProgressBar x:Name="RepairProgress" Minimum="0" Maximum="100" Value="0" Height="18"/><TextBox x:Name="RepairDetails" Height="72" Margin="0,7,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#F8FAFC" BorderBrush="#CBD5E1"/><TextBlock Text="Удаляются все активные локальные данные выбранного GUID: каталог кэша и привязка к Host. ModelLocationTable и центральная модель не изменяются." TextWrapping="Wrap" Foreground="#B45309" Margin="0,9,0,0"/></StackPanel></Border>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Background="#E2E8F0" Padding="20,9"><TextBlock x:Name="StatusText" Text="Готово" Foreground="#334155"/></Border>
  </Grid>
</Window>
