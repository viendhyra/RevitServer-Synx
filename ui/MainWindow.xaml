<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevitServer Synx"
        Width="1500" Height="920"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#0369A1"/>
    <SolidColorBrush x:Key="AccentDark" Color="#075985"/>

    <!-- Кнопки: одинаковый стиль, переносятся в WrapPanel -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinWidth" Value="120"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentDark}"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.4"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="#B91C1C"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
      <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- Поля ввода: тянутся по ширине контейнера -->
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- Заголовок -->
      <RowDefinition Height="Auto"/>   <!-- Панель экземпляра -->
      <RowDefinition Height="Auto"/>   <!-- Панель Host -->
      <RowDefinition Height="*"/>      <!-- Основная зона -->
      <RowDefinition Height="Auto"/>   <!-- Статус -->
    </Grid.RowDefinitions>

    <!-- ===== Заголовок ===== -->
    <Border Grid.Row="0" Background="#082F49" Padding="20,14">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="REVIT SERVER ACCELERATOR" Foreground="#BAE6FD"
                     FontSize="11" FontWeight="Bold"/>
          <TextBlock Text="Synx — диагностика и ремонт кэша" Foreground="White"
                     FontSize="22" FontWeight="Bold" Margin="0,2,0,0"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <TextBlock Text="Режим" Foreground="#BAE6FD" HorizontalAlignment="Right"/>
          <TextBlock x:Name="AdminStatusText" Text="Проверка..."
                     Foreground="White" FontWeight="Bold"
                     HorizontalAlignment="Right"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Панель экземпляра ===== -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,14,16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="2*" MinWidth="180"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="0" Text="Версия Accelerator:"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>

        <ComboBox x:Name="InstanceCombo" Grid.Column="1"
                  DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>

        <!-- Кнопки и сводка переносятся автоматически -->
        <WrapPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal">
          <Button x:Name="RefreshButton" Style="{StaticResource PrimaryButton}"
                  Content="Прочитать логи и базы"/>
          <Button x:Name="LoadNamesButton" Style="{StaticResource PrimaryButton}"
                  Content="База имён..."/>
          <Button x:Name="OpenLogButton" Style="{StaticResource PrimaryButton}"
                  Content="AutoSyncLog"/>
          <Button x:Name="OpenHistoryButton" Style="{StaticResource PrimaryButton}"
                  Content="Журнал Synx" IsEnabled="False"/>
        </WrapPanel>
      </Grid>
      <TextBlock x:Name="SummaryText" Grid.Row="0"
                 Text="Экземпляры ещё не проверены"
                 Foreground="#475569" TextWrapping="Wrap"
                 Margin="0,8,0,0"/>
    </Border>

    <!-- ===== Панель Host ===== -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="16,0,16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="1.2*" MinWidth="160"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="1.2*" MinWidth="160"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Старый Host:"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="OldHostCombo" Grid.Row="0" Grid.Column="1"
                  DisplayMemberPath="Display" HorizontalAlignment="Stretch"/>

        <TextBlock Grid.Row="0" Grid.Column="2" Text="Новый DNS/IP:"
                   VerticalAlignment="Center" Margin="14,0,8,0"/>
        <TextBox x:Name="NewHostText" Grid.Row="0" Grid.Column="3"
                 HorizontalAlignment="Stretch"/>

        <WrapPanel Grid.Row="0" Grid.Column="4" Margin="10,0,0,0">
          <Button x:Name="TestHostButton" Style="{StaticResource PrimaryButton}"
                  Content="Проверить адрес"/>
          <Button x:Name="MigrateHostButton" Style="{StaticResource DangerButton}"
                  Content="Исправить адрес и кэши" IsEnabled="False"/>
          <Button x:Name="LoadHostNamesButton" Style="{StaticResource PrimaryButton}"
                  Content="Получить имена с Host"/>
        </WrapPanel>

        <TextBlock x:Name="HostStatusText" Grid.Row="1" Grid.ColumnSpan="5"
                   Text="После чтения выберите старый адрес. Порты каждой модели будут сохранены."
                   Foreground="#475569" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </Grid>
    </Border>

    <!-- ===== Основная зона ===== -->
    <Grid Grid.Row="3" Margin="16,0,16,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="420"/>
        <ColumnDefinition Width="2*" MinWidth="320"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Модели -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" Text="Модели в кэше Accelerator"
                     FontSize="17" FontWeight="Bold" Margin="0,0,0,8"
                     TextTrimming="CharacterEllipsis"/>
          <DataGrid x:Name="ModelsGrid" MinHeight="200">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding RepeatFailure}" Value="True">
                    <Setter Property="Background" Value="#FECACA"/>
                    <Setter Property="Foreground" Value="#991B1B"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Повтор" Binding="{Binding RepeatText}" Width="Auto"/>
              <DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="Auto"/>
              <DataGridTextColumn Header="Имя модели" Binding="{Binding Name}" Width="*" MinWidth="120"/>
              <DataGridTextColumn Header="GUID модели" Binding="{Binding Guid}" Width="Auto"/>
              <DataGridTextColumn Header="Host" Binding="{Binding HostNode}" Width="Auto"/>
              <DataGridTextColumn Header="Случаев" Binding="{Binding IncidentCount}" Width="Auto"/>
              <DataGridTextColumn Header="Зависаний" Binding="{Binding HangCount}" Width="Auto"/>
              <DataGridTextColumn Header="Ошибок" Binding="{Binding ErrorCount}" Width="Auto"/>
              <DataGridCheckBoxColumn Header="Кэш" Binding="{Binding CacheExists}" Width="Auto"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <!-- Правая колонка -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="3*" MinHeight="150"/>
          <RowDefinition Height="2*" MinHeight="200"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="Ошибки AutoSync"
                       FontSize="17" FontWeight="Bold" Margin="0,0,0,8"
                       TextTrimming="CharacterEllipsis"/>
            <DataGrid x:Name="ErrorsGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Время"
                                    Binding="{Binding Time, StringFormat=dd.MM HH:mm:ss}" Width="Auto"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="Auto"/>
                <DataGridTextColumn Header="GUID" Binding="{Binding Guid}" Width="Auto"/>
                <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="Выбранная модель" FontSize="16" FontWeight="Bold"/>
              <TextBlock x:Name="SelectedText" Text="Выберите строку слева"
                         TextWrapping="Wrap" Foreground="#475569" Margin="0,6,0,10"/>

              <WrapPanel>
                <Button x:Name="RepairButton" Style="{StaticResource DangerButton}"
                        Content="Исправить выбранную" IsEnabled="False"/>
                <Button x:Name="BatchRepairButton" Style="{StaticResource DangerButton}"
                        Content="Исправить все зависшие" IsEnabled="False"/>
                <Button x:Name="CacheCheckButton" Style="{StaticResource PrimaryButton}"
                        Content="Глубокая диагностика" IsEnabled="False"/>
                <Button x:Name="OpenCacheButton" Style="{StaticResource PrimaryButton}"
                        Content="Открыть каталог" IsEnabled="False"/>
              </WrapPanel>

              <TextBlock x:Name="RepairStepText" Text="Ремонт не запущен"
                         Foreground="#334155" FontWeight="SemiBold" Margin="0,10,0,4"/>
              <ProgressBar x:Name="RepairProgress" Minimum="0" Maximum="100"
                           Value="0" Height="16"/>
              <TextBox x:Name="RepairDetails" Height="64" Margin="0,6,0,0"
                       IsReadOnly="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       Background="#F8FAFC" BorderBrush="#CBD5E1"/>
              <TextBlock Text="Бэкап баз: &lt;Revit Server 20xx&gt;\SynxBackup. При смене Host исправляются все затронутые GUID; кэш перемещается в карантин. Центральная модель не изменяется."
                         TextWrapping="Wrap" Foreground="#B45309" Margin="0,8,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <!-- ===== Статус ===== -->
    <Border Grid.Row="4" Background="#E2E8F0" Padding="16,7">
      <TextBlock x:Name="StatusText" Text="Готово" Foreground="#334155"
                 TextTrimming="CharacterEllipsis"/>
    </Border>
  </Grid>
</Window>
