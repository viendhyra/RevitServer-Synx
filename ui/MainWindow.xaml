<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RevitServer Synx" Width="1500" Height="920" MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#F1F5F9" FontFamily="Segoe UI" FontSize="13" Foreground="#0F172A" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#0369A1"/>
    <SolidColorBrush x:Key="AccentDark" Color="#075985"/>
    <SolidColorBrush x:Key="Line" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Muted" Color="#64748B"/>

    <!-- Кнопки: свой шаблон, иначе тема Windows рисует свою подсветку поверх цвета -->
    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="34"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentDark}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#0C4A6E"/></Trigger></Style.Triggers></Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#334155"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F1F5F9"/><Setter Property="BorderBrush" Value="#94A3B8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#E2E8F0"/></Trigger></Style.Triggers></Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="Background" Value="#DC2626"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B91C1C"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#991B1B"/></Trigger></Style.Triggers></Style>
    <Style x:Key="DangerOutlineButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#B91C1C"/><Setter Property="BorderBrush" Value="#FCA5A5"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FEF2F2"/><Setter Property="BorderBrush" Value="#EF4444"/></Trigger></Style.Triggers></Style>

    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#0F172A"/></Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
    <Style x:Key="Divider" TargetType="Border"><Setter Property="Width" Value="1"/><Setter Property="Background" Value="{StaticResource Line}"/><Setter Property="Margin" Value="4,6,12,6"/></Style>

    <Style TargetType="TextBox"><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8,4"/><Setter Property="BorderBrush" Value="#CBD5E1"/></Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8,4"/></Style>

    <Style TargetType="ProgressBar"><Setter Property="Height" Value="8"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid><Border x:Name="PART_Track" CornerRadius="4" Background="#E2E8F0"/><Border x:Name="PART_Indicator" CornerRadius="4" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/></Grid></ControlTemplate></Setter.Value></Setter></Style>

    <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,10,0,0"/></Style>
    <Style TargetType="TabItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Bd" Padding="4,6,4,8" Margin="0,0,20,0" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Cursor="Hand"><ContentPresenter x:Name="Hdr" ContentSource="Header" TextBlock.FontSize="15" TextBlock.FontWeight="SemiBold" TextBlock.Foreground="{StaticResource Muted}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Hdr" Property="TextBlock.Foreground" Value="#0F172A"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hdr" Property="TextBlock.Foreground" Value="#0F172A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

    <!-- Таблицы -->
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="RowHeight" Value="34"/><Setter Property="EnableRowVirtualization" Value="True"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F8FAFC"/><Setter Property="Foreground" Value="#475569"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader"><Grid><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal"><ContentPresenter VerticalAlignment="Center"/><Path x:Name="SortArrow" Visibility="Collapsed" Data="M0,0 L4,4 L8,0 Z" Fill="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/></StackPanel></Border><Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Opacity="0"/></Grid><ControlTemplate.Triggers><Trigger Property="SortDirection" Value="Descending"><Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/><Setter TargetName="SortArrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="White"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F8FAFC"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="10,0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E0F2FE"/><Setter Property="Foreground" Value="#0C4A6E"/></Trigger></Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Шапка -->
    <Border Grid.Row="0" Background="#0B2540" Padding="22,14">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource Accent}" Margin="0,0,12,0"><TextBlock Text="S" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="RevitServer Synx" Foreground="White" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Диагностика и безопасный ремонт кэша Revit Server Accelerator" Foreground="#93C5FD" FontSize="12"/></StackPanel>
        </StackPanel>
        <Border x:Name="AdminBadge" DockPanel.Dock="Right" VerticalAlignment="Center" CornerRadius="14" Padding="12,5" Background="#14532D"><TextBlock x:Name="AdminStatusText" Text="Проверка..." Foreground="#DCFCE7" FontWeight="SemiBold" FontSize="12"/></Border>
      </DockPanel>
    </Border>

    <!-- Экземпляр и общие действия -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,14,16,10" Padding="16,12">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="ЭКЗЕМПЛЯР ACCELERATOR" Style="{StaticResource Caption}"/><ComboBox x:Name="InstanceCombo" DisplayMemberPath="Name"/></StackPanel>
        <WrapPanel Grid.Column="1" VerticalAlignment="Bottom">
          <Button x:Name="RefreshButton" Style="{StaticResource PrimaryButton}" Content="Прочитать логи и базы"/>
          <Button x:Name="LoadNamesButton" Style="{StaticResource SecondaryButton}" Content="База имён..."/>
          <Button x:Name="OpenLogButton" Style="{StaticResource SecondaryButton}" Content="AutoSyncLog"/>
          <Button x:Name="OpenHistoryButton" Style="{StaticResource SecondaryButton}" Content="Журнал Synx" IsEnabled="False"/>
          <Border Style="{StaticResource Divider}"/>
          <Button x:Name="ClearCacheButton" Style="{StaticResource DangerOutlineButton}" Content="Очистить весь кэш..." IsEnabled="False" ToolTip="Весь кэш экземпляра перемещается в SynxQuarantine с остановкой AutoSync/IIS; создаётся Rollback.ps1"/>
        </WrapPanel>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#F8FAFC" CornerRadius="6" Padding="10,7" Margin="0,10,0,0"><TextBlock x:Name="SummaryText" Text="Экземпляры ещё не проверены" Foreground="#475569" TextWrapping="Wrap"/></Border>
      </Grid>
    </Border>

    <!-- Смена адреса Host: нужна редко, поэтому свёрнута -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="16,0,16,10" Padding="16,10">
      <Expander x:Name="HostExpander" IsExpanded="False">
        <Expander.Header><TextBlock Text="Смена адреса Revit Server Host" Style="{StaticResource SectionTitle}" Margin="4,0,0,0"/></Expander.Header>
        <Grid Margin="0,10,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="220"/><ColumnDefinition Width="*" MinWidth="200"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="СТАРЫЙ HOST" Style="{StaticResource Caption}"/><ComboBox x:Name="OldHostCombo" DisplayMemberPath="Display"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="НОВЫЙ DNS-ИМЯ ИЛИ IP" Style="{StaticResource Caption}"/><TextBox x:Name="NewHostText"/></StackPanel>
          <WrapPanel Grid.Column="2" VerticalAlignment="Bottom"><Button x:Name="TestHostButton" Style="{StaticResource PrimaryButton}" Content="Проверить адрес"/><Button x:Name="MigrateHostButton" Style="{StaticResource DangerButton}" Content="Исправить адрес и кэши" IsEnabled="False"/><Button x:Name="LoadHostNamesButton" Style="{StaticResource SecondaryButton}" Content="Получить имена с Host"/></WrapPanel>
          <TextBlock x:Name="HostStatusText" Grid.Row="1" Grid.ColumnSpan="3" Text="После чтения выберите старый адрес. Порты каждой модели будут сохранены." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </Grid>
      </Expander>
    </Border>

    <!-- Рабочая область -->
    <Grid Grid.Row="3" Margin="16,0,16,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="7*" MinWidth="560"/><ColumnDefinition Width="12"/><ColumnDefinition Width="4*" MinWidth="380" MaxWidth="560"/></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,8,16,16">
        <TabControl>
          <TabItem x:Name="ModelsTab" Header="Модели">
            <DataGrid x:Name="ModelsGrid" RowHeight="46">
              <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Style.Triggers><DataTrigger Binding="{Binding RepeatFailure}" Value="True"><Setter Property="Background" Value="#FEF2F2"/><Setter Property="Foreground" Value="#991B1B"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Состояние" SortMemberPath="Status" Width="Auto">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Border x:Name="Pill" CornerRadius="10" Padding="9,2" Background="#DCFCE7"><TextBlock x:Name="PillText" Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="#166534"/></Border>
                      <Border x:Name="RepeatPill" CornerRadius="10" Padding="7,2" Margin="4,0,0,0" Background="#7F1D1D" Visibility="Collapsed"><TextBlock Text="ПОВТОР" FontSize="11" FontWeight="SemiBold" Foreground="White"/></Border>
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Status}" Value="ЗАВИСАНИЕ"><Setter TargetName="Pill" Property="Background" Value="#FEE2E2"/><Setter TargetName="PillText" Property="Foreground" Value="#B91C1C"/></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="ОШИБКА"><Setter TargetName="Pill" Property="Background" Value="#FEF3C7"/><Setter TargetName="PillText" Property="Foreground" Value="#92400E"/></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="НЕТ КЭША"><Setter TargetName="Pill" Property="Background" Value="#F1F5F9"/><Setter TargetName="PillText" Property="Foreground" Value="#475569"/></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="БЕЗ ЗАПИСИ БД"><Setter TargetName="Pill" Property="Background" Value="#E0E7FF"/><Setter TargetName="PillText" Property="Foreground" Value="#3730A3"/></DataTrigger>
                      <DataTrigger Binding="{Binding RepeatFailure}" Value="True"><Setter TargetName="RepeatPill" Property="Visibility" Value="Visible"/></DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Модель" SortMemberPath="Name" Width="1.5*" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelPath}"/><TextBlock Text="{Binding Guid}" FontFamily="Consolas" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Предполагаемая причина" Binding="{Binding Diagnosis}" Width="*" MinWidth="170"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                <DataGridTextColumn Header="Зависаний" Binding="{Binding HangCount}" Width="Auto"/>
                <DataGridTextColumn Header="Ошибок" Binding="{Binding ErrorCount}" Width="Auto"/>
                <DataGridTextColumn Header="Случаев" Binding="{Binding IncidentCount}" Width="Auto"/>
                <DataGridTemplateColumn Header="Кэш" SortMemberPath="CacheExists" Width="Auto"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock x:Name="Mark" Text="нет" Foreground="#94A3B8" HorizontalAlignment="Center"/><DataTemplate.Triggers><DataTrigger Binding="{Binding CacheExists}" Value="True"><Setter TargetName="Mark" Property="Text" Value="✓"/><Setter TargetName="Mark" Property="Foreground" Value="#15803D"/><Setter TargetName="Mark" Property="FontWeight" Value="Bold"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Host" Binding="{Binding HostNode}" Width="Auto"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#475569"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem x:Name="ErrorsTab" Header="Ошибки AutoSync">
            <DataGrid x:Name="ErrorsGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Время" Binding="{Binding Time, StringFormat=dd.MM HH:mm:ss}" Width="Auto"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="Auto"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                <DataGridTextColumn Header="GUID" Binding="{Binding Guid}" Width="Auto"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#64748B"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Raw}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
        </TabControl>
      </Border>

      <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

      <!-- Выбранная модель -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="18,16">
            <TextBlock Text="Выбранная модель" Style="{StaticResource SectionTitle}"/>
            <Border Background="#F8FAFC" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,12"><TextBlock x:Name="SelectedText" Text="Выберите строку слева" TextWrapping="Wrap" Foreground="#334155" LineHeight="20"/></Border>

            <Border x:Name="DiagnosisCard" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
              <StackPanel>
                <DockPanel LastChildFill="False"><TextBlock DockPanel.Dock="Left" Text="ПРЕДПОЛАГАЕМАЯ ПРИЧИНА" Style="{StaticResource Caption}"/><TextBlock x:Name="DiagnosisConfidenceText" DockPanel.Dock="Right" Margin="12,0,0,0" Text="Уверенность: —" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/></DockPanel>
                <TextBlock x:Name="DiagnosisTitleText" Text="Сначала выберите модель" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,6" TextWrapping="Wrap"/>
                <TextBlock x:Name="DiagnosisEvidenceText" Text="Доказательства появятся после анализа." Foreground="#475569" TextWrapping="Wrap" LineHeight="19"/>
                <TextBlock Text="РЕКОМЕНДУЕМОЕ ДЕЙСТВИЕ" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
                <TextBlock x:Name="DiagnosisActionText" Text="—" Foreground="#0F172A" TextWrapping="Wrap" LineHeight="19"/>
              </StackPanel>
            </Border>

            <TextBlock Text="ДИАГНОСТИКА" Style="{StaticResource Caption}"/>
            <WrapPanel Margin="0,0,0,8"><Button x:Name="CacheCheckButton" Style="{StaticResource PrimaryButton}" Content="Найти причину" IsEnabled="False"/><Button x:Name="OpenDiagnosticButton" Style="{StaticResource SecondaryButton}" Content="Открыть отчёт" IsEnabled="False"/><Button x:Name="OpenCacheButton" Style="{StaticResource SecondaryButton}" Content="Открыть каталог" IsEnabled="False"/></WrapPanel>
            <TextBlock Text="РЕМОНТ" Style="{StaticResource Caption}"/>
            <WrapPanel Margin="0,0,0,10"><Button x:Name="RepairButton" Style="{StaticResource DangerButton}" Content="Исправить выбранную" IsEnabled="False"/><Button x:Name="BatchRepairButton" Style="{StaticResource DangerOutlineButton}" Content="Исправить все зависшие" IsEnabled="False"/></WrapPanel>

            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
              <StackPanel>
                <TextBlock x:Name="RepairStepText" Text="Ремонт не запущен" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <ProgressBar x:Name="RepairProgress" Minimum="0" Maximum="100" Value="0"/>
                <TextBox x:Name="RepairDetails" Height="120" Margin="0,10,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Background="#0F172A" Foreground="#CBD5E1" BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="10,8"/>
              </StackPanel>
            </Border>
            <TextBlock Text="Бэкап баз: &lt;Revit Server 20xx&gt;\SynxBackup. Центральная модель напрямую не изменяется." TextWrapping="Wrap" Foreground="#B45309" FontSize="12" Margin="0,10,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Строка состояния -->
    <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,8">
      <DockPanel LastChildFill="True">
        <ProgressBar x:Name="JobProgress" DockPanel.Dock="Right" Width="260" Minimum="0" Maximum="100" Value="0" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
        <TextBlock x:Name="StatusText" Text="Готово" Foreground="#334155" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
